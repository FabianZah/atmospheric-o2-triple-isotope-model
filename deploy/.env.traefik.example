# Copy to deploy/.env.traefik on the server. Do not commit the copied file.
OXYTIB_VERSION=0.1.0
OXYTIB_HOST=model.example.org
OXYTIB_LOCAL_PORT=18000
OXYTIB_ROOT_PATH=/oxytib

# Keep false while staging. Enable only during the reviewed route cutover.
OXYTIB_TRAEFIK_ENABLE=false

# Conservative defaults for a small shared host.
OXYTIB_CPUS=0.75
OXYTIB_MEMORY=768m
OXYTIB_PIDS=128

# Public request and compute guards.
OXYTIB_MAX_REQUEST_BYTES=1048576
OXYTIB_MAX_COMPUTE_REQUESTS=2
OXYTIB_COMPUTE_QUEUE_TIMEOUT_SECONDS=1.0
OXYTIB_RATE_AVERAGE=30
OXYTIB_RATE_PERIOD=1m
OXYTIB_RATE_BURST=10
OXYTIB_INFLIGHT_REQUESTS=4

# Same-origin browser application; no cross-origin API access is required.
OXYTIB_CORS_ORIGINS=
