# Copy to deploy/.env.production and replace the example values.
OXYTIB_DOMAIN=model.example.org
ACME_EMAIL=researcher@example.org

# Keep empty for the bundled same-origin browser application.
OXYTIB_CORS_ORIGINS=

# Release and container resources.
OXYTIB_VERSION=0.1.0
OXYTIB_CPUS=2.0
OXYTIB_MEMORY=2g
OXYTIB_PIDS=256
CADDY_IMAGE=caddy:2.11.4-alpine

# Public request and compute guards.
OXYTIB_MAX_REQUEST_BYTES=1048576
OXYTIB_MAX_COMPUTE_REQUESTS=2
OXYTIB_COMPUTE_QUEUE_TIMEOUT_SECONDS=1.0
