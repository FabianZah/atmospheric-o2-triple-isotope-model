{
	email {$ACME_EMAIL}
}

{$O2_MODEL_DOMAIN} {
	encode zstd gzip

	request_body {
		max_size 2MB
	}

	header {
		-Server
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy no-referrer
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		Content-Security-Policy "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self'; object-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
	}

	reverse_proxy model-api:8000 {
		health_uri /api/v1/health
		health_interval 30s
		transport http {
			dial_timeout 5s
			response_header_timeout 300s
		}
	}

	log {
		output stdout
		format json
	}
}
