# Python
__pycache__/
*.pyc
.pytest_cache/
.pytest_tmp*/
.pytest_*/
.ruff_cache/
*.egg-info/
.venv/
venv/
.tmp/
tmp/
.env
.env.*
!deploy/.env.production.example
!deploy/.env.traefik.example

# Generated outputs are regenerated by the validation/plotting scripts.
# Keep curated release artifacts out of source control; publish them separately
# (e.g. as a release or Zenodo dataset). The digitized-curve CSV cache is the
# exception: it is small derived data the pipeline depends on.
outputs/*
!outputs/young_fig8_digitized_curves.csv
!outputs/young_fig7_digitized_contours.csv

# Third-party copyrighted material — must NOT be redistributed (see LICENSING.md):
#   - cropped scans of Young et al. (2014) figures
#   - extracted text of cited papers
outputs/young_digitization_sources/
reference_texts/
external_data/

# Local copyrighted documents
*.pdf
*.docx
*.xlsx

# CI scratch
gate.log
clima_failed*.log
ci_failed*.log

# Local snapshot bookkeeping; README and version history carry public status.
SNAPSHOT_FILE_LIST.txt
SNAPSHOT_MANIFEST.md
